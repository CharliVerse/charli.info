---
import Base from '../layouts/Base.astro';
import { courseBase, modules, type CoursePage } from '../content/confident-with-ai-course';
const { page, kind = 'module' } = Astro.props as { page: CoursePage; kind?: 'module' | 'tool-card' };
const index = modules.findIndex((item) => item.slug === page.slug);
const previous = index > 0 ? modules[index - 1] : undefined;
const next = index >= 0 && index < modules.length - 1 ? modules[index + 1] : undefined;
const href = (item: CoursePage) => `${courseBase}/${item.number && item.number <= 17 ? 'modules' : 'further-study'}/${item.slug}/`;
const estimatedMinutes = page.estimatedMinutes ?? 10;
const reviewed = page.reviewed ?? '11 August 2026';
const label = (item: CoursePage) => item.number ? `${item.number}. ${item.title}` : item.title;
---
<Base title={`${page.title} | Confident with AI`} description={page.summary} type="LearningResource" prev={previous && href(previous)} next={next && href(next)}>
  <p><a href={`${courseBase}/`}>Confident with AI course contents</a></p>
  <p class="piece-note-label">{kind === 'tool-card' ? 'Dated Tool Card' : page.part}</p>
  <h1>{page.number ? `${page.number}. ` : ''}{page.title}</h1>
  <p class="site-intro">{page.summary}</p>
  <p class="course-meta"><strong>Estimated time:</strong> {estimatedMinutes} minutes. <strong>Last reviewed:</strong> {reviewed}.</p>

  <aside class="course-entry" aria-labelledby="on-this-page">
    <h2 id="on-this-page">What you need to know</h2>
    <p>This page stands alone. No previous AI knowledge is required. You need access to an AI assistant only for the activity.</p>
    {page.slug === '01-start-here' && <p>Go to <a href="https://www.chat.com/">www.chat.com</a> and ask your first question.</p>}
    {page.slug === '01-start-here' && <p>We use ChatGPT for this first exercise because it provides a simple starting point. In the next module, you can choose a different assistant.</p>}
    <p><strong>Learning outcome:</strong> {page.outcome}</p>
    {page.caution && <p><strong>Before you begin:</strong> {page.caution}</p>}
  </aside>

  <section aria-labelledby="lesson-heading">
    <h2 id="lesson-heading">The lesson</h2>
    {page.ideas.map((idea) => <p>{idea}</p>)}
    {page.slug === '01-start-here' && <p>Notice that you do not need to start again. Your second instruction changes the answer within the same conversation.</p>}
    {page.slug === '02-choose-an-ai-assistant' && <p>See the <a href={`${courseBase}/tool-cards/ai-assistants/`}>General AI Assistants Tool Card</a> for services you can try.</p>}
    {page.criteria && <><h3>What to check</h3><ul>{page.criteria.map((criterion) => <li>{criterion}</li>)}</ul></>}
    {page.lessonSections?.map((section) => <section>
      <h3>{section.heading}</h3>
      {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
      {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
    </section>)}
    {page.taskMap && <><h3>Match the task to the kind of help</h3><table><thead><tr><th scope="col">If you need to…</th><th scope="col">Ask AI to…</th></tr></thead><tbody>{page.taskMap.map((row) => <tr><td>{row.need}</td><td>{row.ask}</td></tr>)}</tbody></table></>}
  </section>

  {page.workedExample && <section aria-labelledby="worked-example-heading">
    <h2 id="worked-example-heading">Worked example</h2>
    {page.workedExample.map((paragraph) => <p>{paragraph}</p>)}
  </section>}

  {kind === 'tool-card' && page.slug === 'ai-assistants' && (
    <section aria-labelledby="starting-door-heading">
      <h2 id="starting-door-heading">Starting door for Module 1</h2>
      <p><a href="https://chat.com/">Open chat.com</a>. This short address currently redirects to ChatGPT.</p>
      <p>ChatGPT is named here as a low-friction starting door, not as a recommendation over other assistants. The durable course lessons do not depend on it.</p>
      <p>OpenAI currently says people in the UK can try ChatGPT without creating an account. Without an account, only one conversation is available at a time and it is not saved. Creating or signing into an account may take additional time and may involve an email code or another verification step. OpenAI says phone verification is no longer required for ordinary ChatGPT account creation.</p>
      <p><strong>Link and account information verified:</strong> 5 August 2026.</p>
    </section>
  )}

  <section aria-labelledby="activity-heading">
    <h2 id="activity-heading">Try it</h2>
    {page.slug === '01-start-here' ? (
      <>
        <p>Open <a href="https://www.chat.com/">www.chat.com</a>. Find the message box and ask the assistant to explain something you already understand.</p>
        <p>If you cannot think of a subject, ask: <q>Explain why we have seasons.</q></p>
        <p>When it replies, say:</p>
        <blockquote><p>Make that shorter and give me one example.</p></blockquote>
      </>
    ) : <><p>{page.activity}</p>{page.activitySteps && <><p>{page.slug === '03-first-useful-conversation' ? 'If you need a task, send these messages one at a time in the same conversation:' : 'Fallback prompt:'}</p><ol>{page.activitySteps.map((step) => <li><q>{step}</q></li>)}</ol></>}</>}
  </section>

  {page.slug === '01-start-here' && (
    <section aria-labelledby="stuck-heading">
      <h2 id="stuck-heading">If you get stuck</h2>
      <p>You may be asked to sign in or create an account, and the service may work differently in different places. If you cannot reach the message box, use the <a href={`${courseBase}/tool-cards/ai-assistants/`}>General AI Assistants Tool Card</a> to find another way to continue.</p>
    </section>
  )}

  <section aria-labelledby="checkpoint-heading">
    <h2 id="checkpoint-heading">Checkpoint</h2>
    <p>{page.checkpoint}</p>
  </section>

  <nav class="course-pagination" aria-label="Course page navigation">
    <ul>
      {previous && <li>Previous: <a href={href(previous)}>{label(previous)}</a></li>}
      <li><a href={`${courseBase}/`}>Course contents</a></li>
      {next && <li>Next: <a href={href(next)}>{label(next)}</a></li>}
    </ul>
  </nav>

  <section aria-labelledby="credit-heading">
    <h2 id="credit-heading">About this course</h2>
    <p><em>Confident with AI</em> was created by Charli-Jo Tyrer in association with the Technology Association of Visually Impaired People (TAVIP).</p>
    <p>Licensed under <a rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</p>
  </section>
</Base>
